      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        220,
        240
      ],
      "parameters": {
        "jsCode": "return [{json: {\"state\": \"The invoice amount matches the order, but the vendor bank account has changed.\", \"questions\": {\"route\": {\"type\": \"single_choice\", \"question\": \"Should this invoice continue processing or receive human review?\", \"options\": {\"0\": \"Human review\", \"1\": \"Continue processing\"}}}}}];"
      }
    },
    {
      "id": "5462bf00-b3c0-554e-b718-d82d531de88d",
      "name": "Saina Helm",
      "type": "@saina-run/n8n-nodes-saina.sainaHelm",
      "typeVersion": 1,
      "position": [
        460,
        240
      ],
      "parameters": {
        "state": "={{ $json.state }}",
        "questions": "={{ JSON.stringify($json.questions) }}",
        "mode": "decision",
        "threshold": 0.8,
        "minMargin": 0.05,
        "errorMode": "fallback",
        "timeout": 60
      }
    },
    {
      "id": "a858ca64-d705-54d6-b1fd-77e89406a721",
      "name": "Selected branch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        700,
        160
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ Number($json.saina.answers.route.selection) }}"
      }
    },
    {
      "id": "b470732d-b73a-5ee8-921d-ae18d09769f6",
