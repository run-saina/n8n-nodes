{
  "name": "@run-saina/n8n-nodes-saina",
  "version": "0.2.1",
  "description": "Saina Helm decision node with confidence and fallback routing",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "test": "npm run build && node --test test/*.test.cjs",
    "lint": "n8n-node lint",
    "dev": "n8n-node dev",
    "scan": "node scripts/scan.mjs",
    "scan:published": "node scripts/scan.mjs --published"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SainaHelmApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SainaHelm/SainaHelm.node.js"
    ],
    "strict": true
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.51.3",
    "@n8n/scan-community-package": "0.38.0",
    "@types/node": "^22.0.0",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "author": {
    "name": "Mendrika",
    "email": "dev@saina.run",
    "url": "https://github.com/ramarlina"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/run-saina/n8n-nodes.git"
  },
  "homepage": "https://github.com/run-saina/n8n-nodes#readme",
  "bugs": {
    "url": "https://github.com/run-saina/n8n-nodes/issues",
    "email": "dev@saina.run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
